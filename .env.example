# Copy to .env and fill in only what you use. Never commit .env.
LLM_PROVIDER=extractive        # extractive | openai | bedrock
OPENAI_API_KEY=                # required only when LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
AWS_REGION=us-east-1           # Bedrock uses the standard AWS credential chain
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
EMBEDDING_BACKEND=lsa          # lsa (offline) | sentence-transformers
TOP_K=4
CHUNK_SIZE=80
CHUNK_OVERLAP=20
MIN_GROUNDEDNESS=0.6
MIN_QUERY_COVERAGE=0.4
LOG_LEVEL=INFO
